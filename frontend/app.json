{
  "expo": {
    "name": "El Asesor",
    "slug": "el-asesor",
    "owner": "sachaguz2005",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "elasesor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.sachaguz.elasesor"
    },
    "android": {
      "package": "com.sachaguz.elasesor",
      "adaptiveIcon": {
        "backgroundColor": "#7C5CFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#7C5CFC"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.sachaguz.elasesor",
          "enableGooglePay": false
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Racha",
              "label": "Racha de Instagram",
              "description": "Tu racha de publicaciones, con el resumen de la semana",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "300dp",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PreguntaDelDia",
              "label": "Pregunta del día",
              "description": "La pregunta de hoy de El Asesor",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "300dp",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd342015-b8e0-4cf9-b5f3-d2db44ff26e9"
      }
    }
  }
}
