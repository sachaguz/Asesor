# URL del backend. "localhost" resuelve distinto según dónde corras la app:
# - Web / iOS simulator: http://localhost:8000
# - Emulador Android:    http://10.0.2.2:8000
# - Dispositivo físico (Expo Go): http://<IP-de-LAN-de-tu-compu>:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Client ID (tipo "Web application") de Google Cloud Console, para "Continuar
# con Google". No es secreto — se usa del lado del cliente.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Publishable key de Stripe (Developers > API keys, empieza con pk_) para el
# PaymentSheet de la suscripción "Redes". No es secreta — se usa del lado
# del cliente, tiene que ser del mismo modo (test/live) que STRIPE_SECRET_KEY
# en backend/.env.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
