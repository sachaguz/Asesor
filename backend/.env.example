DATABASE_URL=postgresql+psycopg://asesor:asesor@localhost:5432/asesor
ENV=development

# "mock" (default, sin costo ni red) o "claude" para usar la API real. Este
# es el proveedor "fuerte", para el consejo del día y el chat.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=

# Proveedor económico (modelos open source vía OpenRouter) para pregunta del
# día e idea de contenido — separado del LLM_PROVIDER de arriba a propósito.
# "mock" (default) o "openrouter". Conseguí la key en openrouter.ai/keys.
CHEAP_LLM_PROVIDER=mock
OPENROUTER_API_KEY=
# Cambiar acá para probar otro modelo sin tocar código — ver
# openrouter.ai/models (filtrar por "tools" en supported parameters).
OPENROUTER_MODEL=deepseek/deepseek-v4-pro-20260813

# Client ID (tipo "Web application") de Google Cloud Console — el mismo que
# usa el frontend en EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID. Sin esto, /auth/google
# responde 503.
GOOGLE_CLIENT_ID=

# Login con Instagram ("Instagram API with Instagram Login"). El par
# INSTAGRAM_APP_ID/SECRET es el que aparece bajo Instagram > "API setup with
# Instagram login" en el dashboard de Meta — NO el App ID/Secret principal
# de la app. INSTAGRAM_REDIRECT_URI debe estar registrada tal cual ahí mismo.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://localhost:8000/integrations/instagram/callback

# Importar ventas desde una carpeta de Google Drive. Credenciales OAuth
# "Web application" NUEVAS y separadas de GOOGLE_CLIENT_ID (ese solo verifica
# el login; esto necesita client_secret + refresh_token) — crear en Google
# Cloud Console con la Drive API habilitada, y registrar
# GOOGLE_DRIVE_REDIRECT_URI tal cual ahí. Sin esto, la conexión responde 503.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://localhost:8000/integrations/google-drive/callback

# Envío de correo (verificación de cuenta, recuperar contraseña) vía Resend
# (resend.com). Sin esto, el registro y el "olvidé mi contraseña" siguen
# funcionando pero no mandan ningún correo (falla en silencio).
RESEND_API_KEY=
# onboarding@resend.dev (el default) solo entrega a la casilla dueña de la
# cuenta de Resend — hace falta verificar un dominio propio para mandarle a
# cualquier usuario real.
EMAIL_FROM=El Asesor <onboarding@resend.dev>

# Suscripción "Redes" vía Stripe (PaymentSheet nativo). STRIPE_SECRET_KEY y
# STRIPE_WEBHOOK_SECRET salen del dashboard de Stripe (Developers > API keys
# / Webhooks) — usar las del sandbox (sk_test_/whsec_...) mientras se prueba.
# STRIPE_PRICE_ID_REDES es el ID (price_...) del precio recurrente del
# producto "Redes" en Product catalog. Sin STRIPE_SECRET_KEY, /subscription
# responde 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_REDES=
